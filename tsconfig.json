{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",

    "jsx": "react-jsx",

    "strict": true,

    "noUnusedLocals": true,
    "noUnusedParameters": true,

    "allowJs": false,

    "sourceMap": true,

    "rootDir": "src",
    "outDir": "dist",

    "baseUrl": ".",

    "paths": {
      "@/*": ["src/*"]
    },

    "types": ["vite/client"],

    "resolveJsonModule": true,

    "esModuleInterop": true,

    "forceConsistentCasingInFileNames": true,

    "skipLibCheck": true,

    "ignoreDeprecations": "6.0"
  },

  "include": ["src"]
}
