{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",

    "strict": true,

    "noUnusedLocals": true,
    "noUnusedParameters": true,

    "allowJs": false,

    "sourceMap": true,

    "rootDir": "src",

    "outDir": "dist",

    "baseUrl": "./src",

    "paths": {
      "@/*": ["*"]
    },

    "ignoreDeprecations": "6.0"
  },

  "include": ["src"]
}